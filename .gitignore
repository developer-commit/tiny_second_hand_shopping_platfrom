# ==========================================
# Rust / Cargo 관련 (빌드 산출물)
# ==========================================
# Cargo 빌드 산출물 디렉토리
/target/
**/target/

# Note: 백엔드/프론트엔드 애플리케이션 프로젝트이므로 
# 빌드 재현성과 Docker 멀티스테이지 빌드 안정성을 위해 Cargo.lock은 Git으로 추적합니다.
# (Cargo.lock은 ignore하지 않음)

# ==========================================
# 환경 변수 및 보안 관련 (개인정보 / 비밀키 / 지갑)
# ==========================================
*.env
*.env.*
!.env.example
!.env.template

# 백엔드 BCH(비트코인 캐시) 지갑 키, 프라이빗 키, 인증서 등
*.pem
*.key
*.p12
*.pfx
secrets/
wallets/
*secret*.json
wallet*.json
credentials*.json

# ==========================================
# 로컬 미디어 및 업로드 파일 (Local Storage)
# ==========================================
# image 크레이트 등으로 처리된 로컬 미디어 파일 저장소
/uploads/*
!/uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# ==========================================
# 웹 프론트엔드 빌드 도구 (Leptos / Trunk / WASM)
# ==========================================
# Trunk 및 WASM 빌드 산출물 / 캐시
/dist/
**/dist/
.trunk/
.stage/

# Node.js 패키지 사용 시 (선택적)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# 데이터베이스 및 인프라 로컬 데이터
# ==========================================
# 로컬 SQLite DB 및 데이터베이스 덤프
*.db
*.sqlite
*.sqlite3
*.db-journal

# Docker 로컬 데이터 바인딩 볼륨
pg_data/
redis_data/

# ==========================================
# IDE 및 에디터 설정
# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ / RustRover / CLion
.idea/
*.iml

# 기타 에디터 및 OS
.zed/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ==========================================
# 기타 로그 및 문서
# ==========================================
*.log
tmp/
temp/

# 저작권 및 보안 규정 참조 파일
ANSSI_Rust_Secure_Programming_Rules.md

.venv/
**/.venv/

*.png